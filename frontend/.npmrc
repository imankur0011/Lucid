# ==============================================================================
# Lucid Frontend — npm Configuration
# ==============================================================================

# Suppress noisy npm funding/audit output and deprecation warnings that trigger PowerShell NativeCommandError
fund=false
audit=false
loglevel=error

# Allow install scripts for packages that require native binary setup.
# npm v10+ blocks postinstall scripts by default for unlisted packages.
# unrs-resolver is a Rust-based module resolver used by Next.js Turbopack/oxc-resolver.
# Its postinstall script downloads the correct pre-built native binary for the host platform.
# Without it, the package falls back to a slower WASM build, which can break Turbopack startup.
allow-scripts[]=unrs-resolver

