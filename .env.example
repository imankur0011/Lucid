# ==============================================================================
# Lucid — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root:
#      cp .env.example .env
# 2. Update the values below to match your local environment.
# 3. For security keys (APP_SECRET_KEY, JWT_SECRET_KEY), generate them using:
#      python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE (PostgreSQL 16+) — REQUIRED
# ------------------------------------------------------------------------------
# PostgreSQL is the single operational source of truth for Lucid.
# Stores 62 domain application tables + 1 alembic_version table.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portfolio_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Optional: Direct PostgreSQL Connection URL (overrides individual settings above)
# DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/portfolio_dev

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & APPLICATION SECURITY — REQUIRED
# ------------------------------------------------------------------------------
# Application runtime mode: development | staging | production
APP_ENV=development
APP_PORT=8000

# Secret key used for session security and general cryptographic operations.
# Generate via: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me-to-a-secure-random-app-secret-key-32-chars

# HMAC-SHA256 signing key for JWT tokens (RFC 7518 Section 3.2, min 32 chars).
# Generate via: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-secure-random-jwt-secret-key-min-32-characters-long

# Whitelisted frontend origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. LLM & AGENTIC AI (Google Gemini) — OPTIONAL (Has Rule-Based Fallback)
# ------------------------------------------------------------------------------
# Provider: 'gemini' (cloud) or 'ollama' (local)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Google Gemini API Key: Obtain free key from https://aistudio.google.com/
# If omitted or offline, Lucid automatically engages its deterministic rule-based engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama URL (only used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. FINANCIAL CONSTANTS & BENCHMARKS — OPTIONAL (Defaults Provided)
# ------------------------------------------------------------------------------
# Benchmark risk-free rate percentage for Sharpe ratio calculations (India 10Y G-Sec yield)
RISK_FREE_RATE_PCT=7.0

# ------------------------------------------------------------------------------
# 5. EXTERNAL API KEYS — OPTIONAL
# ------------------------------------------------------------------------------
# Federal Reserve Economic Data (FRED) API Key (for US macro cross-reference)
# Free registration at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# NewsAPI Key (secondary financial news feed for sentiment analysis)
# Free registration at: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Note: Yahoo Finance (yfinance) and NSE/BSE scrapers require no API keys.

# ------------------------------------------------------------------------------
# 6. LOCAL DATA DIRECTORIES — OPTIONAL
# ------------------------------------------------------------------------------
# Local filesystem directories for offline CSV ingestion and caching
DATA_RAW_DIR=../data/raw
DATA_PROCESSED_DIR=../data/processed
