# ==============================================================================
# Lucid — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root:
#      cp .env.example .env
# 2. Update the values below to match your local environment.
# 3. In staging/production, JWT_SECRET_KEY must be a cryptographically random
#    string of at least 32 characters (RFC 7518 Section 3.2).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE (PostgreSQL 16) — REQUIRED
# ------------------------------------------------------------------------------
# PostgreSQL is the SINGLE OPERATIONAL SOURCE OF TRUTH for Lucid.
# All 62 relational tables (users, securities, market data, portfolios, agents) reside here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=majorproject
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Optional: Direct PostgreSQL Connection URL (Overrides individual settings above if provided)
# DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/majorproject

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & APPLICATION SECURITY — REQUIRED
# ------------------------------------------------------------------------------
# Application runtime mode: development | staging | production
APP_ENV=development
APP_PORT=8000

# Secret key used for session security and general cryptographic operations
APP_SECRET_KEY=change-me-to-a-secure-random-app-secret-key-32-chars

# HMAC-SHA256 signing key for JWT tokens. MUST be at least 32 characters in production.
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-secure-random-jwt-secret-key-min-32-characters-long

# Whitelisted frontend origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. LLM & AGENTIC AI (Google Gemini) — OPTIONAL (Has Rule-Based Fallbacks)
# ------------------------------------------------------------------------------
# Provider: 'gemini' (cloud) or 'ollama' (local)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Google Gemini API Key: Obtain from https://aistudio.google.com/
# If omitted or offline, Lucid automatically engages deterministic qualitative fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama URL (only used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. FINANCIAL CONSTANTS & BENCHMARKS — OPTIONAL (Defaults Provided)
# ------------------------------------------------------------------------------
# Benchmark risk-free rate percentage for Sharpe ratio calculations (India 10Y G-Sec yield)
RISK_FREE_RATE_PCT=7.0

# ------------------------------------------------------------------------------
# 5. EXTERNAL API KEYS — OPTIONAL
# ------------------------------------------------------------------------------
# Federal Reserve Economic Data (FRED) API Key (for US macro cross-reference)
FRED_API_KEY=your_fred_api_key_here

# NewsAPI Key (for financial news feeds)
NEWS_API_KEY=your_newsapi_key_here

# ------------------------------------------------------------------------------
# 6. LOCAL DATA DIRECTORIES — OPTIONAL
# ------------------------------------------------------------------------------
# Local filesystem directories for offline CSV ingestion and caching
DATA_RAW_DIR=../data/raw
DATA_PROCESSED_DIR=../data/processed
